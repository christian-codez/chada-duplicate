#. Plugin Name of the plugin
#: includes/Admin/SettingsPage.php:43
#: includes/Admin/SettingsPage.php:44
#: includes/Admin/SettingsPage.php:109
msgid "Chada Duplicate"
msgstr "Chada Duplicate"

#. Plugin URI of the plugin
msgid "https://shop.chadacreatives.com/chada-duplicate"
msgstr "https://shop.chadacreatives.com/chada-duplicate"

#. Description of the plugin
msgid "One-click duplicate / clone for posts, pages, public custom post types, and WooCommerce products (including variations). Fast, complete clones that copy meta, taxonomies, the featured image, and full product data."
msgstr "Ein-Klick-Duplizieren / Klonen für Beiträge, Seiten, öffentliche benutzerdefinierte Inhaltstypen und WooCommerce-Produkte (inklusive Variationen). Schnelle, vollständige Klone, die Metadaten, Taxonomien, das Beitragsbild und alle Produktdaten kopieren."

#. Author of the plugin
msgid "Chada Creatives"
msgstr "Chada Creatives"

#. Author URI of the plugin
msgid "https://chadacreatives.com"
msgstr "https://chadacreatives.com"

#: includes/Admin/CrossSell.php:47
